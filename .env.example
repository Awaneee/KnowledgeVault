# KnowledgeVault Backend — Environment Configuration
# ====================================================
# Copy this file to .env and fill in the required values.
# Lines beginning with # are comments.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledgevault
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledgevault

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# REQUIRED: generate a secret of at least 32 characters before deploying.
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# JSON list of allowed origins. Use ["*"] for local dev only.
# For production, set explicit origins: ["https://app.example.com"]
CORS_ALLOWED_ORIGINS=["*"]

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# LLM Provider Routing
# ---------------------------------------------------------------------------
# Comma-separated priority list for ANSWER GENERATION.
# Supported: gemini, groq, ollama
# Intent extraction always uses Gemini → rule-based (Groq is excluded
# from intent extraction to ensure schema-compliant JSON output).
LLM_PROVIDER_PRIORITY=gemini,groq

# Legacy fallback — used if LLM_PROVIDER_PRIORITY is not set.
LLM_PROVIDER=gemini

# Timeout (seconds) for any LLM API call.
LLM_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Gemini — Primary provider
# Get your API key at https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_INTENT_MODEL=gemini-2.0-flash
GEMINI_ANSWER_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Groq — Secondary production provider (answer generation only)
# Get your API key at https://console.groq.com/keys
# Groq is used when Gemini fails or returns a quota error.
# ---------------------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_BASE=https://api.groq.com/openai/v1

# ---------------------------------------------------------------------------
# Ollama — Local development only
# Set OLLAMA_ENABLED=true to include Ollama in the fallback chain.
# Leave OLLAMA_ENABLED=false (default) in all production deployments.
# ---------------------------------------------------------------------------
OLLAMA_ENABLED=false
OLLAMA_URL=http://host.docker.internal:11434/api/generate
OLLAMA_INTENT_MODEL=phi3:mini
OLLAMA_TITLE_MODEL=phi3:mini
OLLAMA_ANSWER_MODEL=llama3

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
# Minimum score threshold for retrieved chunks (0.0–1.0).
# Chunks below this score are excluded before LLM synthesis and from
# the retrieval-only response. Set to 0.0 to disable filtering.
RETRIEVAL_MIN_SCORE=0.10

# Category similarity thresholds for intent-based retrieval.
CATEGORY_INGEST_THRESHOLD=0.28
CATEGORY_QUERY_THRESHOLD=0.55

# ---------------------------------------------------------------------------
# Ask / Cache
# ---------------------------------------------------------------------------
# TTL in seconds for cached Ask responses. Set to 0 to disable caching.
ASK_CACHE_TTL_SECONDS=3600
