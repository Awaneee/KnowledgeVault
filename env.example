# ─────────────────────────────────────────────
# Copy this file to .env and fill in the values
# cp .env.example .env
# ─────────────────────────────────────────────

# PostgreSQL - used by docker-compose to create the DB
# and by the app via DATABASE_URL
POSTGRES_USER=knowledgevault
POSTGRES_PASSWORD=changeme
POSTGRES_DB=knowledgevault

# Constructed automatically by docker-compose from the three vars above.
# Only set this manually if running outside Docker (local dev without containers).
# Local:  DATABASE_URL=postgresql://knowledgevault:changeme@localhost:5432/knowledgevault
# Docker: set automatically - do not override
DATABASE_URL=postgresql://knowledgevault:changeme@localhost:5432/knowledgevault

# Redis
# Local:  redis://localhost:6379/0
# Docker: set automatically - do not override
REDIS_URL=redis://localhost:6379/0

# JWT - generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme_generate_a_real_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Ollama - runs on your host machine, not in Docker
# Windows/Mac: use host.docker.internal so containers can reach it
# Linux:       use your machine's LAN IP (e.g. 192.168.1.x)
OLLAMA_URL=http://host.docker.internal:11434/api/generate
